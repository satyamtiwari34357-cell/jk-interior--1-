datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  PROPOSAL
  WON
  CLOSED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Project {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  location         String
  category         String
  propertyType     String?
  year             String?
  area             String?
  shortDescription String?
  fullDescription  String?
  concept          String?
  scopeOfWork      String?
  materials        String[]       @default([])
  featured         Boolean        @default(false)
  isConcept        Boolean        @default(false)
  status           ProjectStatus  @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  images           ProjectImage[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([category])
}

model ProjectImage {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url              String
  secureUrl        String?
  publicId         String?
  filename         String?
  originalFilename String?
  alt              String?
  caption          String?
  width            Int?
  height           Int?
  aspectRatio      Float?
  format           String?
  sortOrder        Int      @default(0)
  isCover          Boolean  @default(false)
  source           String   @default("JK_INTERIOR")
  isConcept        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([projectId])
}

model Service {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String?
  description      String?
  image            String?
  sortOrder        Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  projectName String?
  quote       String
  role        String?
  image       String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}

model Lead {
  id                     String      @id @default(cuid())
  name                   String
  customerType           String?
  phone                  String
  whatsapp               String?
  email                  String?
  preferredContactMethod String?
  projectType            String
  propertyType           String?
  location               String
  carpetAreaRange        String?
  carpetAreaSqFt         Int?
  budgetRange            String?
  requirements           String?
  timeline               String?
  bhk                    String?
  projectStatus          String?
  message                String?
  source                 String?     @default("website")
  status                 LeadStatus  @default(NEW)
  internalNotes          String?
  lastContactedAt        DateTime?
  nextFollowUpAt         DateTime?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmTerm                String?
  utmContent             String?
  landingPage            String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Media {
  id               String   @id @default(cuid())
  url              String
  secureUrl        String?
  publicId         String?
  filename         String
  originalFilename String?
  alt              String?
  width            Int?
  height           Int?
  format           String?
  mimeType         String?
  folder           String?
  source           String   @default("JK_INTERIOR")
  isConcept        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  content        String?
  published      Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
}

model SiteSettings {
  id             String   @id @default(cuid())
  studioName     String   @default("JK Interior")
  founderName    String   @default("Kishorilal Sharma")
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  serviceArea    String?  @default("Mumbai")
  instagram      String?
  facebook       String?
  linkedin       String?
  youtube        String?
  logoUrl        String?
  faviconUrl     String?
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
}
