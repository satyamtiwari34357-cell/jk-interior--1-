# PostgreSQL connection string. Required for database-backed production features.
DATABASE_URL=""

# Optional server integrations
PEXELS_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
EMAIL_API_KEY=""
EMAIL_FROM=""
LEADS_NOTIFICATION_EMAIL=""

# Public, server-generated absolute links. Leave empty for request-host detection.
SITE_URL=""

# Optional browser-visible analytics identifier. Never put private credentials in VITE_*.
VITE_GA_MEASUREMENT_ID=""

# Server-only admin hashing secret. Generate a unique random value for each deployment.
ADMIN_SESSION_SECRET=""

# Server runtime
PORT=3000
DISABLE_HMR=false
